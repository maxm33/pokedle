<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="icon" href="/public/images/icons/favicon.ico" />
    <script>
      try {
        const authState = sessionStorage.getItem("pokedleAuthState");
        if (authState === "signed-in" || authState === "signed-out") {
          document.documentElement.dataset.authState = authState;
        }
      } catch (err) {
        console.error("Failed to restore navigation state:", err);
      }
    </script>
    <link rel="stylesheet" href="/public/stylesheets/style.css" />
    <link rel="preconnect" href="https://www.gstatic.com" />
    <link
      rel="preload"
      as="script"
      href="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"
    />
    <link
      rel="manifest"
      type="application/manifest+json"
      href="/public/app.webmanifest"
    />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <meta
      name="description"
      content="Pokédle is a game heavily inspired by Wordle and LoLdle, in which you have to guess the daily secret pokémon."
    />
    <title>Pokédle - Classic</title>
  </head>
  <body style="--page-background-image: url(&quot;<%= bg %>&quot;)">
    <div id="topnav" role="banner">
      <div id="credits">
        <p id="author">
          Created by <a href="https://github.com/maxm33">maxm33</a>
        </p>
        <img
          alt=""
          src="/public/images/misc/github-mark.webp"
          width="20px"
          height="20px"
        />
      </div>
      <div
        id="auth-loading"
        class="auth-loading"
        role="status"
        aria-live="polite"
      >
        <span class="profile-loader" aria-hidden="true"></span>
        <span>Checking authentication...</span>
      </div>
      <div id="buttons-container">
        <button id="login-button" class="topnav-buttons">
          <img
            id="login-img"
            alt=""
            src="/public/images/misc/login.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button
          id="shop-button"
          class="topnav-buttons"
          type="button"
          aria-label="Shop"
          title="Shop"
        >
          <img
            alt=""
            src="/public/images/misc/shop.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="ranking-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/ranking.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="pokedex-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/pokedex.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="profile-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/profile.webp"
            width="35px"
            height="35px"
          />
        </button>
      </div>
    </div>
    <div id="container" role="main">
      <div id="logo-container">
        <div id="logo">
          <a aria-label="Go to Home" href="/"
            ><img
              fetchpriority="high"
              alt=""
              src="/public/images/misc/pokedle-logo.webp"
          /></a>
        </div>
        <div id="mode">Classic</div>
      </div>
      <div id="mode-switch" class="fadeIn">
        <a class="mode-link" href="/sentry">Play Sentry Duty</a>
      </div>
      <div id="prev-next">
        <div id="prev">
          <% const previousPokemonDisplayName = prev.name .replace("Farfetchd",
          "Farfetch'd") .replace("NidoranF", "Nidoran♀") .replace("NidoranM",
          "Nidoran♂"); const previousPokemonSlug = prev.name .toLowerCase()
          .replace("mr. mime", "mr-mime") .replace("nidoranf", "nidoran-female")
          .replace("nidoranm", "nidoran-male") .replace("mime jr.", "mime-jr")
          .replaceAll(" ", "-"); %> Last was<br />
          <a
            id="previous-pokemon-link"
            href="https://www.pokemon.com/it/pokedex/<%= previousPokemonSlug %>"
            ><%= previousPokemonDisplayName %></a
          >
          #<%= String(prev.ID).padStart(3, "0") %>
        </div>
        <div id="timer">
          Reset in<br />
          ........
        </div>
      </div>
      <div
        id="event-notifications"
        class="event-notification-carousel"
        role="region"
        aria-roledescription="carousel"
        aria-label="Event notifications"
        hidden
      >
        <div class="event-notification-controls">
          <button
            id="event-notification-previous"
            class="event-notification-arrow"
            type="button"
            aria-label="Previous notification"
            hidden
          >
            &lt;
          </button>
          <div
            id="event-notification-swiper"
            class="event-notification-swiper"
            tabindex="0"
          >
            <div
              id="event-notification"
              class="event-notification"
              role="status"
              aria-live="polite"
              hidden
            >
              <span class="event-icon" aria-hidden="true">🔔</span>
              <span>
                Exclusive event today!<br /><br />
                Today's Pokémon is guaranteed to be legendary!
              </span>
              <button
                class="event-notification-dismiss"
                type="button"
                aria-label="Hide this notification"
                title="Hide notification"
              >
                🗑
              </button>
            </div>
            <div
              id="event-notification-double"
              class="event-notification"
              role="status"
              aria-live="polite"
              hidden
            >
              <span class="event-icon" aria-hidden="true">💰</span>
              <span>
                Exclusive event today!<br /><br />
                Winning Classic mode will reward you with 2x Pokédollars!
              </span>
              <button
                class="event-notification-dismiss"
                type="button"
                aria-label="Hide this notification"
                title="Hide notification"
              >
                🗑
              </button>
            </div>
            <div
              id="event-notification-shiny"
              class="event-notification"
              role="status"
              aria-live="polite"
              hidden
            >
              <span class="event-icon" aria-hidden="true">✨</span>
              <span>
                Exclusive event today!<br /><br />
                Today's Pokémon is guaranteed to be shiny!
              </span>
              <button
                class="event-notification-dismiss"
                type="button"
                aria-label="Hide this notification"
                title="Hide notification"
              >
                🗑
              </button>
            </div>
          </div>
          <button
            id="event-notification-next"
            class="event-notification-arrow"
            type="button"
            aria-label="Next notification"
            hidden
          >
            &gt;
          </button>
        </div>
        <div
          id="event-notification-indicators"
          class="event-notification-indicators"
          role="group"
          aria-label="Choose event notification"
          hidden
        ></div>
      </div>
      <div id="subtitle" style="margin: 0; display: none">
        <p>
          We're done for today...<br /><br />
          Check other game modes too!
        </p>
      </div>
      <div
        id="state-loading"
        class="state-loading"
        role="status"
        aria-live="polite"
      >
        <span class="profile-loader" aria-hidden="true"></span>
        <span id="state-loading-message">Retrieving game state...</span>
      </div>
      <div id="textbar-container" style="display: none">
        <div id="autocomplete">
          <input
            id="textbar"
            type="text"
            name="pokemon"
            placeholder="Type the Pokémon here..."
          />
        </div>
        <button id="guess-button" type="submit" aria-label="Submit guess">
          <span class="guess-pokeball-scene" aria-hidden="true">
            <span class="guess-pokeball-bouncer">
              <span class="guess-pokeball-shaker">
                <span class="guess-pokeball-squasher">
                  <span class="guess-pokeball">
                    <span class="guess-pokeball-light"></span>
                    <span class="guess-pokeball-top">
                      <span class="guess-pokeball-half-face"></span>
                      <span class="guess-pokeball-button"></span>
                    </span>
                    <span class="guess-pokeball-bottom">
                      <span class="guess-pokeball-half-face"></span>
                    </span>
                  </span>
                </span>
              </span>
            </span>
          </span>
        </button>
      </div>
      <div id="state-container" style="display: none">
        <div id="titles-container">
          <div class="titles">
            <p></p>
          </div>
          <div class="titles">
            <p>Place</p>
          </div>
          <div class="titles">
            <p>Color</p>
          </div>
          <div class="titles">
            <p>Type</p>
          </div>
          <div class="titles">
            <p>Fully Evo</p>
          </div>
          <div class="titles">
            <p>Evo Lvl</p>
          </div>
          <div class="titles">
            <p>Gen</p>
          </div>
        </div>
        <div id="answers-container"></div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script
      type="module"
      src="/public/js/rankingNotifications.js?v=<%= encodeURIComponent(appVersion) %>"
    ></script>
    <script
      type="module"
      src="/public/js/classicMode.js?v=<%= encodeURIComponent(appVersion) %>"
    ></script>
  </body>
</html>
