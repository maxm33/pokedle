<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="icon" href="/public/images/icons/favicon.ico" />
    <link rel="stylesheet" href="/public/stylesheets/style.css" />
    <link rel="preconnect" href="https://www.gstatic.com" />
    <link
      rel="preload"
      as="script"
      href="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"
    />
    <link
      rel="manifest"
      type="application/manifest+json"
      href="/public/app.webmanifest"
    />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <title>Pokédle - Classic</title>
  </head>
  <body style="background-image: url(&quot;<%= bg %>&quot;)">
    <div id="topnav" role="banner">
      <div id="credits">
        <p id="author">
          Created by <a href="https://github.com/maxm33">maxm33</a>
        </p>
        <img
          alt=""
          src="/public/images/icons/github-mark.webp"
          width="20px"
          height="20px"
        />
      </div>
      <div id="buttons-container">
        <button id="login-button" class="topnav-buttons">
          <img
            id="login-img"
            alt=""
            src="/public/images/misc/login.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="ranking-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/ranking.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="pokedex-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/pokedex.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="profile-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/profile.webp"
            width="35px"
            height="35px"
          />
        </button>
      </div>
    </div>
    <div id="container" role="main">
      <div id="logo-container">
        <div id="logo">
          <a aria-label="Go to Home" href="/"
            ><img fetchpriority="high" alt="" src="/public/images/icons/pokedle-logo.webp"
          /></a>
        </div>
        <div id="mode">Classic</div>
      </div>
      <div id="mode-switch" class="fadeIn">
        <a class="mode-link" href="/sentry">Play Sentry Duty</a>
      </div>
      <div id="prev-next">
        <div id="prev">
          Last was<br />
          <%= prev.name %> #<%= prev.ID %>
        </div>
        <div id="timer">
          Reset in<br />
          ..........
        </div>
      </div>
      <div id="subtitle" style="margin: 0; display: none">
        <p>Don't move!</br>Next will be legen... Wait for it...</p>
      </div>
      <div id="textbar-container" style="display: none">
        <div id="autocomplete">
          <input
            id="textbar"
            type="text"
            name="pokemon"
            placeholder="Type the Pokémon here..."
          />
        </div>
        <button id="guess-button" type="submit">Guess</button>
      </div>
      <div id="state-container" style="display: none">
        <div id="titles-container">
          <div class="titles">
            <p></p>
          </div>
          <div class="titles">
            <p>Place</p>
          </div>
          <div class="titles">
            <p>Color</p>
          </div>
          <div class="titles">
            <p>Type</p>
          </div>
          <div class="titles">
            <p>Fully Evo</p>
          </div>
          <div class="titles">
            <p>Evo Lvl</p>
          </div>
          <div class="titles">
            <p>Gen</p>
          </div>
        </div>
        <div id="answers-container"></div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script type="module" src="/public/js/classicMode.js"></script>
  </body>
</html>
