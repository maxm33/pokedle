<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", {
    title: "Pokédle - Classic",
    description: "Pokédle is a game heavily inspired by Wordle and LoLdle, in which you have to guess the daily secret pokémon.",
    modules: ["base", "profile", "game", "classic", "profile-account", "responsive"],
    preconnect: true
  }) %>
  <body style="--page-background-image: url(&quot;<%= bg %>&quot;)">
        <%- include("partials/topnav") %>
    <aside
      id="game-mode-nav"
      class="game-mode-nav is-collapsed fadeIn"
      aria-label="Game modes"
    >
      <div id="game-mode-nav-panel" class="game-mode-nav-panel">
        <h2>Modes</h2>
        <div class="game-mode-nav-slots">
          <div class="game-mode-item">
            <a
              class="game-mode-link"
              href="/classic"
              aria-label="Classic"
              title="Classic"
            >
              <img
                src="/public/images/misc/pokedle-logo.webp"
                alt=""
                aria-hidden="true"
              />
            </a>
            <span class="game-mode-label">Classic</span>
          </div>
          <div class="game-mode-item">
            <a
              class="game-mode-link sentry-mode-link"
              href="/sentry"
              aria-label="Sentry Duty"
              title="Sentry Duty"
            >
              <img
                class="game-mode-sentry-frame"
                src="/public/images/sentry/footprint-grate-frame.png"
                alt=""
                aria-hidden="true"
              />
              <img
                class="game-mode-sentry-footprint"
                src="/public/images/sentry/footprints/Groudon.png"
                alt=""
                aria-hidden="true"
              />
            </a>
            <span class="game-mode-label">Sentry Duty</span>
          </div>
        </div>
      </div>
      <button
        id="game-mode-nav-toggle"
        class="game-mode-nav-toggle"
        type="button"
        aria-controls="game-mode-nav-panel"
        aria-expanded="false"
        aria-label="Expand game modes"
        title="Expand game modes"
      ><span aria-hidden="true">‹</span></button>
    </aside>
    <div id="container" role="main">
      <div id="logo-container">
        <div id="logo">
          <a aria-label="Go to Home" href="/"
            ><img
              fetchpriority="high"
              alt=""
              src="/public/images/misc/pokedle-logo.webp"
          /></a>
        </div>
        <div id="mode">Classic</div>
      </div>
      <div id="mode-switch" class="fadeIn" aria-hidden="true"></div>
      <div id="prev-next" aria-label="Daily Pokédex status">
        <section id="prev" class="daily-status-card" aria-label="Previous Pokémon">
          <span class="daily-status-label">Previous</span>
          <div class="previous-pokemon">
            <% if (prev) { %>
              <div class="previous-pokemon-info">
                <a
                  id="previous-pokemon-link"
                  href="https://www.pokemon.com/it/pokedex/<%= prevSlug %>"
                >
                  <%= prevDisplayName %>
                </a>
                <span class="previous-pokemon-number">#<%= String(prev.ID).padStart(3, "0") %></span>
              </div>
              <img
                class="previous-pokemon-sprite"
                src="/public/images/sprites/<%= prev.name %>.webp"
                alt=""
                aria-hidden="true"
              />
            <% } else { %>
              <span class="previous-pokemon-empty">Preparing Pokédex...</span>
            <% } %>
          </div>
        </section>
        <div class="daily-status-divider" aria-hidden="true">
          <span class="status-seal"></span>
        </div>
        <section id="timer" class="daily-status-card" aria-label="Time until reset">
          <span class="daily-status-label">Next encounter</span>
          <time id="timer-value" datetime="PT0H0M0S">--:--:--</time>
        </section>
      </div>
      <div
        id="event-notifications"
        class="event-notification-carousel"
        role="region"
        aria-roledescription="carousel"
        aria-label="Event notifications"
        hidden
      >
        <div class="event-notification-controls">
          <button
            id="event-notification-previous"
            class="event-notification-arrow"
            type="button"
            aria-label="Previous notification"
            hidden
          >
            &lt;
          </button>
          <div
            id="event-notification-swiper"
            class="event-notification-swiper"
            tabindex="0"
          >
            <div
              id="event-notification"
              class="event-notification"
              role="status"
              aria-live="polite"
              hidden
            >
              <span class="event-icon" aria-hidden="true">🔔</span>
              <span>
                Exclusive event today!<br /><br />
                Today's Pokémon is guaranteed to be legendary!
              </span>
              <button
                class="event-notification-dismiss"
                type="button"
                aria-label="Hide this notification"
                title="Hide notification"
              >
                🗑
              </button>
            </div>
            <div
              id="event-notification-double"
              class="event-notification"
              role="status"
              aria-live="polite"
              hidden
            >
              <span class="event-icon" aria-hidden="true">💰</span>
              <span>
                Exclusive event today!<br /><br />
                Winning Classic mode will reward you with 2x Pokédollars!
              </span>
              <button
                class="event-notification-dismiss"
                type="button"
                aria-label="Hide this notification"
                title="Hide notification"
              >
                🗑
              </button>
            </div>
            <div
              id="event-notification-shiny"
              class="event-notification"
              role="status"
              aria-live="polite"
              hidden
            >
              <span class="event-icon" aria-hidden="true">✨</span>
              <span>
                Exclusive event today!<br /><br />
                Today's Pokémon is guaranteed to be shiny!
              </span>
              <button
                class="event-notification-dismiss"
                type="button"
                aria-label="Hide this notification"
                title="Hide notification"
              >
                🗑
              </button>
            </div>
          </div>
          <button
            id="event-notification-next"
            class="event-notification-arrow"
            type="button"
            aria-label="Next notification"
            hidden
          >
            &gt;
          </button>
        </div>
        <div
          id="event-notification-indicators"
          class="event-notification-indicators"
          role="group"
          aria-label="Choose event notification"
          hidden
        ></div>
      </div>
      <div id="subtitle" class="zero-margin hidden-initially">
        <p>
          We're done for today...<br /><br />
          Check other game modes too!
        </p>
      </div>
      <div
        id="state-loading"
        class="state-loading"
        role="status"
        aria-live="polite"
      >
        <span class="profile-loader" aria-hidden="true"></span>
        <span id="state-loading-message">Retrieving game state...</span>
      </div>
      <div id="textbar-container" class="hidden-initially">
        <div id="autocomplete">
          <input
            id="textbar"
            type="text"
            name="pokemon"
            placeholder="Type the Pokémon here..."
          />
        </div>
        <button id="guess-button" type="submit" aria-label="Submit guess">
          <span class="guess-pokeball-scene" aria-hidden="true">
            <span class="guess-pokeball-bouncer">
              <span class="guess-pokeball-shaker">
                <span class="guess-pokeball-squasher">
                  <span class="guess-pokeball">
                    <span class="guess-pokeball-light"></span>
                    <span class="guess-pokeball-top">
                      <span class="guess-pokeball-half-face"></span>
                      <span class="guess-pokeball-button"></span>
                    </span>
                    <span class="guess-pokeball-bottom">
                      <span class="guess-pokeball-half-face"></span>
                    </span>
                  </span>
                </span>
              </span>
            </span>
          </span>
        </button>
      </div>
      <div id="state-container" class="hidden-initially">
        <div id="titles-container">
          <div class="titles">
            <p></p>
          </div>
          <div class="titles">
            <p>Place</p>
          </div>
          <div class="titles">
            <p>Color</p>
          </div>
          <div class="titles">
            <p>Type</p>
          </div>
          <div class="titles">
            <p>Fully Evo</p>
          </div>
          <div class="titles">
            <p>Evo Lvl</p>
          </div>
          <div class="titles">
            <p>Gen</p>
          </div>
        </div>
        <div id="answers-container"></div>
      </div>
    </div>
    <%- include("partials/page-modules", {
      modules: ["rankingNotifications", "classicMode", "gameModeNavigation"],
    }) %>
  </body>
</html>
