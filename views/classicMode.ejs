<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="icon" href="/public/images/icons/favicon.ico" />
    <link rel="stylesheet" href="/public/stylesheets/style.css" />
    <link rel="preconnect" href="https://www.gstatic.com" />
    <link
      rel="preload"
      as="script"
      href="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"
    />
    <link
      rel="manifest"
      type="application/manifest+json"
      href="/public/app.webmanifest"
    />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <meta
      name="description"
      content="Pokédle is a game heavily inspired by Wordle and LoLdle, in which you have to guess the daily secret pokémon."
    />
    <title>Pokédle - Classic</title>
  </head>
  <body style="--page-background-image: url(&quot;<%= bg %>&quot;)">
    <div id="topnav" role="banner">
      <div id="credits">
        <p id="author">
          Created by <a href="https://github.com/maxm33">maxm33</a>
        </p>
        <img
          alt=""
          src="/public/images/icons/github-mark.webp"
          width="20px"
          height="20px"
        />
      </div>
      <div
        id="auth-loading"
        class="auth-loading"
        role="status"
        aria-live="polite"
      >
        <span class="profile-loader" aria-hidden="true"></span>
        <span>Checking authentication...</span>
      </div>
      <div id="buttons-container">
        <button id="login-button" class="topnav-buttons">
          <img
            id="login-img"
            alt=""
            src="/public/images/misc/login.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="ranking-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/ranking.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="pokedex-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/pokedex.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="profile-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/profile.webp"
            width="35px"
            height="35px"
          />
        </button>
      </div>
    </div>
    <div id="container" role="main">
      <div id="logo-container">
        <div id="logo">
          <a aria-label="Go to Home" href="/"
            ><img
              fetchpriority="high"
              alt=""
              src="/public/images/icons/pokedle-logo.webp"
          /></a>
        </div>
        <div id="mode">Classic</div>
      </div>
      <div id="mode-switch" class="fadeIn">
        <a class="mode-link" href="/sentry">Play Sentry Duty</a>
      </div>
      <div id="prev-next">
        <div id="prev">
          <% const previousPokemonDisplayName = prev.name
            .replace("Farfetchd", "Farfetch'd")
            .replace("NidoranF", "Nidoran♀")
            .replace("NidoranM", "Nidoran♂");
          const previousPokemonSlug = prev.name
            .toLowerCase()
            .replace("mr. mime", "mr-mime")
            .replace("nidoranf", "nidoran-female")
            .replace("nidoranm", "nidoran-male")
            .replace("mime jr.", "mime-jr")
            .replaceAll(" ", "-"); %>
          Last was<br />
          <a href="https://www.pokemon.com/it/pokedex/<%= previousPokemonSlug %>"><%= previousPokemonDisplayName %></a>
          #<%= String(prev.ID).padStart(3, "0") %>
        </div>
        <div id="timer">
          Reset in<br />
          ..........
        </div>
      </div>
      <div
        id="event-notification"
        class="event-notification"
        role="status"
        aria-live="polite"
        hidden
      >
        <span class="event-icon" aria-hidden="true">🔔</span>
        <span>
          Exclusive event today!<br /><br />
          Generated Pokémon is guaranteed to be a legendary one!<br /><br />
          Go catch it before it flees!
        </span>
      </div>
      <div id="subtitle" style="margin: 0; display: none">
        <p>
          We're done for today...<br /><br />
          Check other game modes too!
        </p>
      </div>
      <div
        id="state-loading"
        class="state-loading"
        role="status"
        aria-live="polite"
      >
        <span class="profile-loader" aria-hidden="true"></span>
        <span id="state-loading-message">Retrieving game state...</span>
      </div>
      <div id="textbar-container" style="display: none">
        <div id="autocomplete">
          <input
            id="textbar"
            type="text"
            name="pokemon"
            placeholder="Type the Pokémon here..."
          />
        </div>
        <button id="guess-button" type="submit" aria-label="Submit guess">
          <span class="guess-pokeball-scene" aria-hidden="true">
            <span class="guess-pokeball-bouncer">
              <span class="guess-pokeball-shaker">
                <span class="guess-pokeball-squasher">
                  <span class="guess-pokeball">
                    <span class="guess-pokeball-light"></span>
                    <span class="guess-pokeball-top">
                      <span class="guess-pokeball-half-face"></span>
                      <span class="guess-pokeball-button"></span>
                    </span>
                    <span class="guess-pokeball-bottom">
                      <span class="guess-pokeball-half-face"></span>
                    </span>
                  </span>
                </span>
              </span>
            </span>
          </span>
        </button>
      </div>
      <div id="state-container" style="display: none">
        <div id="titles-container">
          <div class="titles">
            <p></p>
          </div>
          <div class="titles">
            <p>Place</p>
          </div>
          <div class="titles">
            <p>Color</p>
          </div>
          <div class="titles">
            <p>Type</p>
          </div>
          <div class="titles">
            <p>Fully Evo</p>
          </div>
          <div class="titles">
            <p>Evo Lvl</p>
          </div>
          <div class="titles">
            <p>Gen</p>
          </div>
        </div>
        <div id="answers-container"></div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script type="module" src="/public/js/classicMode.js"></script>
  </body>
</html>
