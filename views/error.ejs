<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", {
    title: "Error",
    modules: ["base", "responsive"],
    includeAuthState: false
  }) %>
  <body style="--page-background-image: url(&quot;<%= bg %>&quot;)">
    <div id="container" role="main">
      <div id="logo" class="fadeIn">
        <a aria-label="Go to Home" href="/"
          ><img
            fetchpriority="high"
            alt=""
            src="/public/images/misc/pokedle-logo.webp"
        /></a>
      </div>
      <div class="fadeIn inline-error-message">
        <h1>Error <%= error.status %>: <%= message %></h1>
        <br />
        <img
          src="/public/images/misc/confused-pikachu.webp"
          width="250px"
          height="250px"
        />
      </div>
    </div>
  </body>
</html>
