<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", {
    title: "Pokédle - Sentry Duty",
    description: "Guess the pokémon's footprint quickly! Based on the Pokémon Mystery Dungeon series mini-game.",
    modules: [
      "base",
      "profile",
      "game",
      "profile-account",
      "responsive",
      "sentry",
      "music-player",
    ],
    preconnect: true
  }) %>
  <body
    class="sentry-page"
    style="--page-background-image: url(&quot;<%= bg %>&quot;)"
  >
        <%- include("partials/topnav") %>
    <aside
      id="game-mode-nav"
      class="game-mode-nav is-collapsed fadeIn"
      aria-label="Game modes"
    >
      <div id="game-mode-nav-panel" class="game-mode-nav-panel">
        <h2>Modes</h2>
        <div class="game-mode-nav-slots">
          <div class="game-mode-item">
            <a
              class="game-mode-link"
              href="/classic"
              aria-label="Classic"
              title="Classic"
            >
              <img
                src="/public/images/misc/pokedle-logo.webp"
                alt=""
                aria-hidden="true"
              />
            </a>
            <span class="game-mode-label">Classic</span>
          </div>
          <div class="game-mode-item">
            <a
              class="game-mode-link sentry-mode-link"
              href="/sentry"
              aria-label="Sentry Duty"
              title="Sentry Duty"
            >
              <img
                class="game-mode-sentry-frame"
                src="/public/images/sentry/footprint-grate-frame.png"
                alt=""
                aria-hidden="true"
              />
              <img
                class="game-mode-sentry-footprint"
                src="/public/images/sentry/footprints/Groudon.png"
                alt=""
                aria-hidden="true"
              />
            </a>
            <span class="game-mode-label">Sentry Duty</span>
          </div>
        </div>
      </div>
      <button
        id="game-mode-nav-toggle"
        class="game-mode-nav-toggle"
        type="button"
        aria-controls="game-mode-nav-panel"
        aria-expanded="false"
        aria-label="Expand game modes"
        title="Expand game modes"
      ><span aria-hidden="true">‹</span></button>
    </aside>
    <div id="container" role="main">
      <div id="logo-container">
        <div id="logo">
          <a aria-label="Play Sentry Duty" href="/sentry">
            <img
              fetchpriority="high"
              alt=""
              src="/public/images/misc/pokedle-logo.webp"
            />
          </a>
        </div>
        <div id="mode">Sentry Duty</div>
      </div>
      <div id="mode-switch" class="fadeIn" aria-hidden="true"></div>
      <div
        id="event-notifications"
        class="event-notification-carousel"
        role="region"
        aria-roledescription="carousel"
        aria-label="Notifications"
        hidden
      >
        <div class="event-notification-controls">
          <button
            id="event-notification-previous"
            class="event-notification-arrow"
            type="button"
            aria-label="Previous notification"
            hidden
          >
            &lt;
          </button>
          <div
            id="event-notification-swiper"
            class="event-notification-swiper"
            tabindex="0"
          ></div>
          <button
            id="event-notification-next"
            class="event-notification-arrow"
            type="button"
            aria-label="Next notification"
            hidden
          >
            &gt;
          </button>
        </div>
        <div
          id="event-notification-indicators"
          class="event-notification-indicators"
          role="group"
          aria-label="Choose notification"
          hidden
        ></div>
      </div>
      <div id="sentry-status" class="fadeIn">
        <h2 id="sentry-title" class="fadeIn">Guess the footprint quickly!</h2>
        <div id="sentry-feedback" class="fadeIn">Whose foot is this?</div>
      </div>
      <div id="sentry-game-layout">
        <div id="sentry-footprint-container" class="fadeIn">
          <div
            id="sentry-failures-count"
            class="sentry-grate-stat sentry-top-left"
            title="Failures"
          >
            X: 0/3
          </div>
          <button
            id="sentry-mute"
            class="sentry-grate-stat sentry-top-mid fadeIn"
            aria-pressed="false"
            title="Mute / Unmute"
          >
            🔊
          </button>
          <div
            id="sentry-score-count"
            class="sentry-grate-stat sentry-top-right"
            title="Score"
          >
            0
          </div>
          <div id="sentry-timer-bar-container">
            <div id="sentry-timer-bar"></div>
          </div>
          <img id="sentry-footprint" alt="" />
          <div id="sentry-overlay" aria-hidden="true"></div>
        </div>
        <div id="sentry-options" class="sentry-options fadeIn"></div>
      </div>
      <audio id="sentry-audio" loop preload="auto">
        <source src="/public/audio/sentry_duty_ost.mp3" type="audio/mpeg" />
      </audio>
      <audio id="sentry-feedback-audio" preload="auto"></audio>
    </div>

    <%- include("partials/page-modules", {
      modules: [
        "rankingNotifications",
        "sentryMode",
        "gameModeNavigation",
        "musicPlayer",
      ],
    }) %>
  </body>
</html>
