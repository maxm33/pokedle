<aside id="music-player" class="music-player" aria-label="Music player">
  <div class="music-player-panel" id="music-player-panel" hidden>
    <div class="music-player-track">
      <span class="music-player-track-line music-player-track-title-line">
        <span class="music-player-track-marquee">
          <span class="music-player-track-title" id="music-track-title"></span>
          <span
            class="music-player-track-title"
            id="music-track-title-copy"
            aria-hidden="true"
          ></span>
        </span>
      </span>
      <span class="music-player-track-line music-player-track-album-line">
        <span class="music-player-track-marquee">
          <span class="music-player-track-album" id="music-track-album"></span>
          <span
            class="music-player-track-album"
            id="music-track-album-copy"
            aria-hidden="true"
          ></span>
        </span>
      </span>
    </div>
    <div class="music-player-controls">
      <button
        class="music-player-control"
        id="music-previous"
        type="button"
        aria-label="Previous song"
        title="Previous song"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 5v14M19 6l-9 6 9 6z" />
        </svg>
      </button>
      <button
        class="music-player-control music-player-play"
        id="music-play"
        data-playing="false"
        type="button"
        aria-label="Play"
        title="Play"
      >
        <svg class="music-play-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m8 5 12 7-12 7z" />
        </svg>
        <svg class="music-pause-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7 5h4v14H7zM15 5h4v14h-4z" />
        </svg>
      </button>
      <button
        class="music-player-control"
        id="music-next"
        type="button"
        aria-label="Next song"
        title="Next song"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 5v14M5 6l9 6-9 6z" />
        </svg>
      </button>
      <button
        class="music-player-control music-player-loop"
        id="music-loop"
        type="button"
        aria-label="Repeat current track"
        aria-pressed="false"
        title="Repeat current track"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15" />
          <path d="M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3" />
          <text x="9.25" y="14.5">1</text>
        </svg>
      </button>
    </div>
  </div>
  <div class="music-player-mascot">
    <div
      class="music-player-oak-dance"
      id="music-player-oak-dance"
      aria-hidden="true"
    >
      <img data-src="/public/images/misc/professor-oak-dance.gif" alt="" />
    </div>
    <button
      class="music-player-volume-toggle"
      id="music-volume-toggle"
      type="button"
      aria-label="Open volume control"
      aria-expanded="false"
      aria-controls="music-volume-panel"
      title="Volume"
    >
      <svg class="music-volume-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z" />
        <path
          class="music-volume-waves"
          d="M16 9a5 5 0 0 1 0 6m2-9a9 9 0 0 1 0 12"
        />
      </svg>
    </button>
    <div class="music-volume-panel" id="music-volume-panel" hidden>
      <label for="music-volume">Volume</label>
      <input
        id="music-volume"
        type="range"
        min="0"
        max="1"
        step="0.01"
        value="0.65"
        aria-label="Volume"
      />
    </div>
    <button
      class="music-player-mascot-button"
      id="music-mascot-button"
      type="button"
      aria-label="Open music player"
    >
      <img
        id="music-player-mascot-image"
        src="/public/images/misc/DJ-Pika.gif"
        alt=""
      />
    </button>
  </div>
  <audio id="music-audio" preload="metadata"></audio>
</aside>
