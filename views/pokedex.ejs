<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="icon" href="/public/images/icons/favicon.ico" />
    <link rel="stylesheet" href="/public/stylesheets/style.css" />
    <link
      rel="manifest"
      type="application/manifest+json"
      href="/public/app.webmanifest"
    />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <title>Pokédex</title>
  </head>
  <body style="--page-background-image: url(&quot;<%= bg %>&quot;)">
    <div id="topnav" role="banner">
      <div id="credits">
        <p id="author">
          Created by <a href="https://github.com/maxm33">maxm33</a>
        </p>
        <img
          alt=""
          src="/public/images/icons/github-mark.webp"
          width="20px"
          height="20px"
        />
      </div>
      <div
        id="auth-loading"
        class="auth-loading"
        role="status"
        aria-live="polite"
      >
        <span class="profile-loader" aria-hidden="true"></span>
        <span>Checking authentication...</span>
      </div>
      <div id="buttons-container">
        <button id="login-button" class="topnav-buttons">
          <img
            id="login-img"
            alt=""
            src="/public/images/misc/login.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="ranking-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/ranking.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="pokedex-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/pokedex.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="profile-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/profile.webp"
            width="35px"
            height="35px"
          />
        </button>
      </div>
    </div>
    <div id="container" role="main">
      <div id="logo" class="fadeIn">
        <a aria-label="Go to Home" href="/"
          ><img
            fetchpriority="high"
            alt=""
            src="/public/images/icons/pokedle-logo.webp"
        /></a>
      </div>
      <div id="dex-device" class="fadeIn">
        <section class="dex-panel dex-left-panel" aria-label="Pokémon sprite">
          <div class="dex-sensor-header" aria-hidden="true">
            <span class="dex-main-lens"></span>
            <span class="dex-small-lights">
              <span class="dex-light dex-light-red"></span>
              <span class="dex-light dex-light-yellow"></span>
              <span class="dex-light dex-light-green"></span>
            </span>
          </div>
          <div class="dex-screen-container">
            <div class="dex-screen-header" aria-hidden="true">
              <span class="dex-micro-light"></span>
              <span class="dex-micro-light"></span>
            </div>
            <div class="dex-main-screen">
              <img
                id="dex-sprite"
                class="dex-pokemon-sprite"
                src="/public/images/sprites/unknown.webp"
                alt=""
              />
              <span id="dex-new" class="dex-new" hidden>NEW</span>
            </div>
          </div>
          <nav class="dex-navigation" aria-label="Pokémon navigation">
            <button id="dex-previous" type="button">Previous</button>
            <span id="dex-entry-position" aria-live="polite">Loading</span>
            <button id="dex-next" type="button">Next</button>
          </nav>
        </section>
        <section class="dex-panel dex-right-panel" aria-label="Pokémon details">
          <div class="dex-info-screen" aria-live="polite">
            <h1 id="dex-heading"><a id="dex-pokemon-link"></a></h1>
            <p id="dex-generation" class="dex-generation"></p>
            <p id="dex-description" class="dex-description"></p>
            <div class="dex-record">
              <p><strong>Status:</strong> <span id="dex-status"></span></p>
              <p><strong>Guessed:</strong> <span id="dex-guesses"></span></p>
              <p><strong>Date:</strong> <span id="dex-date"></span></p>
              <p>
                <strong>Trainer:</strong>
                <a id="dex-profile-link"><%= username %></a>
              </p>
              <p>
                <strong>Pokédex progress:</strong>
                <span id="dex-discovered"></span>
              </p>
            </div>
            <button
              id="dex-shiny-toggle"
              class="dex-shiny-toggle"
              type="button"
              hidden
              aria-pressed="false"
            >
              Show shiny sprite
            </button>
          </div>
          <div class="dex-filter-grid" aria-label="Pokédex filters">
            <label class="dex-filter-button" for="hide-undiscovered">
              <input id="hide-undiscovered" type="checkbox" checked />
              <span>Hide undiscovered</span>
            </label>
            <label class="dex-filter-button" for="sort-latest">
              <input id="sort-latest" type="checkbox" />
              <span>Order by discovery date</span>
            </label>
            <label class="dex-filter-button" for="shiny-only">
              <input id="shiny-only" type="checkbox" />
              <span>Shinies only</span>
            </label>
          </div>
          <p id="dex-error" class="dex-error" role="alert" hidden></p>
        </section>
      </div>
    </div>
    <script type="module">
      import { pokemons } from "../../public/js/pokemons.js";

      const history = <%- JSON.stringify(history || []).replace(/</g, "\\u003c") %>;
      const normalizeName = (name) => name.toLowerCase().replace(/[^a-z0-9]/g, "");
      const errorElement = document.getElementById("dex-error");
      function showDescriptionError(error) {
        console.error(error);
        errorElement.textContent =
          "Pokédex descriptions could not be loaded. Please try again later.";
        errorElement.hidden = false;
        document.getElementById("dex-pokemon-link").textContent =
          "Pokédex unavailable";
      }
      let rawDescriptions;
      try {
        const descriptionsResponse = await fetch(
          "/public/data/pokedexDescriptions.json",
        );
        if (!descriptionsResponse.ok) {
          throw new Error(
            `Unable to load Pokédex descriptions: ${descriptionsResponse.status}`,
          );
        }
        rawDescriptions = await descriptionsResponse.json();
      } catch (error) {
        showDescriptionError(error);
        throw error;
      }
      const descriptions = new Map(
        Object.entries(rawDescriptions).map(([name, description]) => [
          normalizeName(name),
          description,
        ]),
      );
      const missingDescriptions = pokemons.filter(
        (name) => !descriptions.has(normalizeName(name)),
      );
      if (missingDescriptions.length > 0) {
        const error = new Error(
          `Missing Pokédex descriptions for: ${missingDescriptions.join(", ")}`,
        );
        showDescriptionError(error);
        throw error;
      }

      const historyByPokemon = new Map(
        history.map((entry) => [entry.pokemon, entry]),
      );
      const discoveredPokemon = new Set(historyByPokemon.keys());
      const latestDate = history.reduce((latest, entry) => {
        const date = parseHistoryDate(entry.date);
        return date !== null && (latest === null || date > latest)
          ? date
          : latest;
      }, null);
      const records = pokemons.map((name, index) => ({
        id: index + 1,
        name,
        displayName: getPokemonDisplayName(name),
        history: historyByPokemon.get(name),
      }));
      let visibleRecords = [];
      let currentIndex = -1;
      let showShiny = false;

      const elements = {
        generation: document.getElementById("dex-generation"),
        description: document.getElementById("dex-description"),
        status: document.getElementById("dex-status"),
        guesses: document.getElementById("dex-guesses"),
        date: document.getElementById("dex-date"),
        discovered: document.getElementById("dex-discovered"),
        sprite: document.getElementById("dex-sprite"),
        new: document.getElementById("dex-new"),
        position: document.getElementById("dex-entry-position"),
        previous: document.getElementById("dex-previous"),
        next: document.getElementById("dex-next"),
        shinyToggle: document.getElementById("dex-shiny-toggle"),
        hideUndiscovered: document.getElementById("hide-undiscovered"),
        sortLatest: document.getElementById("sort-latest"),
        shinyOnly: document.getElementById("shiny-only"),
      };
      const profilePath = window.location.pathname.replace(
        /\/pokedex\/?$/,
        "/profile",
      );
      document.getElementById("dex-profile-link").href = profilePath;

      function getPokemonDisplayName(name) {
        return name
          .replace("Farfetchd", "Farfetch'd")
          .replace("NidoranF", "Nidoran♀")
          .replace("NidoranM", "Nidoran♂");
      }

      function getPokemonSlug(name) {
        return name
          .toLowerCase()
          .replace("mr. mime", "mr-mime")
          .replace("nidoranf", "nidoran-female")
          .replace("nidoranm", "nidoran-male")
          .replace("mime jr.", "mime-jr")
          .replaceAll(" ", "-");
      }

      function parseHistoryDate(dateString) {
        const match = /^(\d{2})-(\d{2})-(\d{4})$/.exec(dateString || "");
        if (!match) return null;

        const [day, month, year] = match.slice(1).map(Number);
        const timestamp = Date.UTC(year, month - 1, day);
        const parsedDate = new Date(timestamp);
        if (
          parsedDate.getUTCDate() !== day ||
          parsedDate.getUTCMonth() + 1 !== month ||
          parsedDate.getUTCFullYear() !== year
        )
          return null;

        return timestamp;
      }

      function getGeneration(id) {
        if (id <= 151) return "Generation I";
        if (id <= 251) return "Generation II";
        if (id <= 386) return "Generation III";
        if (id <= 493) return "Generation IV";
        return "Generation V";
      }

      function getVisibleRecords() {
        let filtered = records.filter((record) => {
          const discovered = discoveredPokemon.has(record.name);
          return (
            (!elements.hideUndiscovered.checked || discovered) &&
            (!elements.shinyOnly.checked || record.history?.shiny === true)
          );
        });

        if (elements.sortLatest.checked) {
          filtered = filtered.sort((left, right) => {
            const leftDate = left.history
              ? parseHistoryDate(left.history.date)
              : null;
            const rightDate = right.history
              ? parseHistoryDate(right.history.date)
              : null;
            if (leftDate !== rightDate) {
              if (leftDate === null) return 1;
              if (rightDate === null) return -1;
              return rightDate - leftDate;
            }
            return left.id - right.id;
          });
        }
        return filtered;
      }

      function renderRecord() {
        const record = visibleRecords[currentIndex];
        const hasRecord = record !== undefined;
        elements.previous.disabled = !hasRecord || currentIndex === 0;
        elements.next.disabled =
          !hasRecord || currentIndex === visibleRecords.length - 1;

        if (!hasRecord) {
          const pokemonLink = document.getElementById("dex-pokemon-link");
          pokemonLink.removeAttribute("href");
          pokemonLink.textContent = "No Pokémon match these filters";
          elements.generation.textContent = "";
          elements.description.textContent = "";
          elements.status.textContent = "No matching entries";
          elements.guesses.textContent = "—";
          elements.date.textContent = "—";
          elements.sprite.src = "/public/images/sprites/unknown.webp";
          elements.sprite.alt = "";
          elements.new.hidden = true;
          elements.position.textContent = "0 / 0";
          elements.shinyToggle.hidden = true;
          return;
        }

        const entry = record.history;
        const shiny = entry?.shiny === true;
        const date = entry ? parseHistoryDate(entry.date) : null;
        showShiny = false;
        const pokemonLink = document.getElementById("dex-pokemon-link");
        pokemonLink.textContent = `#${String(record.id).padStart(3, "0")} ${record.displayName}`;
        if (entry) {
          pokemonLink.href = `https://www.pokemon.com/it/pokedex/${getPokemonSlug(record.name)}`;
        } else {
          pokemonLink.removeAttribute("href");
        }
        elements.generation.textContent = getGeneration(record.id);
        elements.description.textContent = descriptions.get(
          normalizeName(record.name),
        );
        elements.status.textContent = entry ? "Discovered" : "Not discovered";
        elements.guesses.textContent = entry
          ? String(entry.timesGuessed)
          : "—";
        elements.date.textContent = entry?.date || "—";
        elements.discovered.textContent = `${history.length}/${records.length}`;
        elements.sprite.src = entry
          ? `/public/images/sprites/${record.name}.webp`
          : "/public/images/sprites/unknown.webp";
        elements.sprite.alt = entry ? record.displayName : "Undiscovered Pokémon";
        elements.new.hidden = !(
          entry?.timesGuessed === 1 &&
          latestDate !== null &&
          date === latestDate
        );
        elements.position.textContent = `${currentIndex + 1} / ${visibleRecords.length}`;
        elements.shinyToggle.hidden = !shiny;
        elements.shinyToggle.setAttribute("aria-pressed", "false");
        elements.shinyToggle.textContent = "Show shiny sprite";
      }

      function updateVisibleRecords(resetToFirst = false) {
        const currentRecord = visibleRecords[currentIndex];
        visibleRecords = getVisibleRecords();
        if (resetToFirst || visibleRecords.length === 0) {
          currentIndex = visibleRecords.length > 0 ? 0 : -1;
        } else if (currentRecord) {
          const preservedIndex = visibleRecords.findIndex(
            (record) => record.name === currentRecord.name,
          );
          currentIndex = preservedIndex >= 0 ? preservedIndex : 0;
        } else {
          currentIndex = 0;
        }
        renderRecord();
      }

      function navigate(direction) {
        const nextIndex = currentIndex + direction;
        if (nextIndex < 0 || nextIndex >= visibleRecords.length) return;
        currentIndex = nextIndex;
        renderRecord();
      }

      elements.previous.addEventListener("click", () => navigate(-1));
      elements.next.addEventListener("click", () => navigate(1));
      elements.shinyToggle.addEventListener("click", () => {
        const record = visibleRecords[currentIndex];
        if (!record?.history?.shiny) return;
        showShiny = !showShiny;
        elements.sprite.src = `/public/images/sprites/${record.name}${showShiny ? "_shiny" : ""}.webp`;
        elements.sprite.alt = `${record.displayName}${showShiny ? " (Shiny)" : ""}`;
        elements.shinyToggle.setAttribute("aria-pressed", String(showShiny));
        elements.shinyToggle.textContent = showShiny
          ? "Show base sprite"
          : "Show shiny sprite";
      });
      for (const filter of [
        elements.hideUndiscovered,
        elements.sortLatest,
        elements.shinyOnly,
      ]) {
        filter.addEventListener("change", () => updateVisibleRecords(true));
      }
      document.addEventListener("keydown", (event) => {
        if (
          event.altKey ||
          event.ctrlKey ||
          event.metaKey ||
          event.target instanceof HTMLInputElement ||
          event.target instanceof HTMLButtonElement ||
          event.target instanceof HTMLAnchorElement
        )
          return;
        if (event.key === "ArrowLeft") navigate(-1);
        if (event.key === "ArrowRight") navigate(1);
      });

      updateVisibleRecords();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script type="module" src="/public/js/auth.js"></script>
  </body>
</html>
