<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="icon" href="/public/images/icons/favicon.ico" />
    <link rel="stylesheet" href="/public/stylesheets/style.css" />
    <link
      rel="manifest"
      type="application/manifest+json"
      href="/public/app.webmanifest"
    />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <title>Pokédex</title>
  </head>
  <body style="background-image: url(&quot;<%= bg %>&quot;)">
    <div id="topnav" role="banner">
      <div id="credits">
        <p id="author">
          Created by <a href="https://github.com/maxm33">maxm33</a>
        </p>
        <img
          alt=""
          src="/public/images/icons/github-mark.webp"
          width="20px"
          height="20px"
        />
      </div>
      <div id="buttons-container">
        <button id="login-button" class="topnav-buttons">
          <img
            id="login-img"
            alt=""
            src="/public/images/misc/login.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="ranking-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/ranking.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="pokedex-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/pokedex.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="profile-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/profile.webp"
            width="35px"
            height="35px"
          />
        </button>
      </div>
    </div>
    <div id="container" role="main">
      <div id="logo" class="fadeIn">
        <a aria-label="Go to Home" href="/"
          ><img
            fetchpriority="high"
            alt=""
            src="/public/images/icons/pokedle-logo.webp"
        /></a>
      </div>
      <h1 id="dex-trainer">
        Trainer: <a id="dex-profile-link"><%= name %></a>
      </h1>
      <h2 id="dex-discovered"></h2>
      <label id="dex-filter-label" for="hide-undiscovered">
        <input id="hide-undiscovered" type="checkbox" checked />
        Hide undiscovered Pokémon
      </label>
    </div>
    <script type="module">
      function getPokemonSlug(pokemonName) {
        return pokemonName
          .toLowerCase()
          .replace("mr. mime", "mr-mime")
          .replace("nidoranf", "nidoran-female")
          .replace("nidoranm", "nidoran-male")
          .replace("mime jr.", "mime-jr")
          .replaceAll(" ", "-");
      }

      function getPokemonDisplayName(pokemonName) {
        return pokemonName
          .replace("Farfetchd", "Farfetch'd")
          .replace("NidoranF", "Nidoran♀")
          .replace("NidoranM", "Nidoran♂");
      }

      let url = window.location.href;
      let ref = url.substring(0, url.length - 8); // removing "/pokedex"
      document.getElementById("dex-profile-link").href = ref + "/profile";

      let container = document.getElementById("container");
      let div = document.createElement("DIV");
      div.setAttribute("id", "dex-container");

      // generating all the pokedex rows as unknown
      for (let i = 0; i < pokemons.length; i++) {
        let pokemonName = pokemons[i];
        let pokemonSlug = getPokemonSlug(pokemonName);
        let pokemonDisplayName = getPokemonDisplayName(pokemonName);

        let subdiv = document.createElement("DIV");
        subdiv.setAttribute("class", "dex-rows");
        subdiv.setAttribute("id", pokemonName);
        subdiv.innerHTML = `<p class="dex-rows-numbers">${i + 1}.</p>
    <img alt="${pokemonDisplayName}" src="/public/images/sprites/unknown.webp" width="90px" height="90px"/>
    <p class="dex-rows-names dex-rows-unknown-name">${pokemonDisplayName}</p>`;
        div.appendChild(subdiv);
      }
      container.appendChild(div);

      // replacing unknown rows with known ones (according to the user's history)
      let history = `<%- JSON.stringify(history) %>`;
      history = JSON.parse(history);
      let discoveredPokemon = new Set(history.map((entry) => entry.pokemon));
      document.getElementById("dex-discovered").textContent =
        `${history.length}/${pokemons.length} Pokémons discovered`;
      for (let i = 0; i < history.length; i++) {
        let subdiv = document.getElementById(history[i].pokemon);
        let pokemonName = history[i].pokemon;
        let pokemonSlug = getPokemonSlug(pokemonName);
        let pokemonDisplayName = getPokemonDisplayName(pokemonName);

        subdiv.innerHTML = `<p class="dex-rows-numbers">${subdiv.firstChild.innerHTML}</p>
    <img alt="${pokemonDisplayName}" src="/public/images/sprites/${pokemonName}.webp" width="100px" height="100px"/>
    <a class="dex-rows-names" href="https://www.pokemon.com/it/pokedex/${pokemonSlug}">${pokemonDisplayName}</a>
    <p class="dex-rows-guesses">Guessed: ${history[i].timesGuessed}</p>`;
      }

      let hideUndiscovered = document.getElementById("hide-undiscovered");
      let rows = document.querySelectorAll(".dex-rows");
      function updateUndiscoveredVisibility() {
        for (let i = 0; i < rows.length; i++) {
          rows[i].hidden =
            hideUndiscovered.checked && !discoveredPokemon.has(rows[i].id);
        }
      }
      hideUndiscovered.addEventListener("change", updateUndiscoveredVisibility);
      updateUndiscoveredVisibility();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script type="module" src="/public/js/auth.js"></script>
  </body>
</html>
