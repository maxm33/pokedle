<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", {
    title: "Profile",
    modules: ["base", "profile", "sentry", "profile-account", "responsive"]
  }) %>
  <body
    class="profile-page<%= hasCustomBackground ? ' profile-has-custom-background' : ''%>"
    style="--page-background-image: url(&quot;<%= bg%>&quot;); --profile-default-background-image: url(&quot;<%= defaultBg%>&quot;); --profile-overlay-image: <%= overlay ? 'url(' + overlay + ')' : 'none'%>"
    data-rate-limit-toast="<%= typeof rateLimitToast === 'string' ? rateLimitToast : '' %>"
  >
        <%- include("partials/topnav") %>
    <button
      id="profile-background-toggle"
      type="button"
      aria-label="Show only the profile background"
      aria-pressed="false"
      title="Show only the profile background"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          class="profile-eye-open"
          d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Zm10 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"
        />
        <path
          class="profile-eye-slash"
          d="m3 3 18 18M10.6 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.7 15.7 0 0 1-3.1 3.8M6.2 6.2C3.5 8.1 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4.1-.8"
        />
      </svg>
    </button>
    <aside
      id="profile-presets"
      class="profile-presets is-collapsed fadeIn"
      data-profile-id="<%= profileId %>"
      aria-label="Saved profile configurations"
      hidden
    >
      <div id="profile-presets-panel" class="profile-presets-panel">
        <h2>Looks</h2>
        <div class="profile-presets-slots">
          <% for (let slot = 0; slot < 5; slot++) { %>
          <div class="profile-preset-slot">
            <button
              class="profile-preset-button"
              type="button"
              data-slot="<%= slot %>"
              aria-label="Save configuration in slot <%= slot + 1 %>"
            >
              <span class="profile-preset-add" aria-hidden="true">+</span>
              <img
                class="profile-preset-companion"
                alt=""
                aria-hidden="true"
                hidden
              />
            </button>
            <button
              class="profile-preset-delete"
              type="button"
              data-slot="<%= slot %>"
              aria-label="Delete configuration from slot <%= slot + 1 %>"
              title="Delete saved configuration"
              hidden
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4 7h16M9 7V4h6v3m-9 0 1 13h10l1-13M10 11v5m4-5v5" />
              </svg>
            </button>
          </div>
          <% } %>
        </div>
      </div>
      <button
        id="profile-presets-toggle"
        class="profile-presets-toggle"
        type="button"
        aria-controls="profile-presets-panel"
        aria-expanded="false"
        aria-label="Expand saved configurations"
        title="Expand saved configurations"
      ><span aria-hidden="true">‹</span></button>
    </aside>
    <div id="container" role="main">
      <div id="logo" class="fadeIn">
        <a aria-label="Go to Home" href="/"
          ><img
            fetchpriority="high"
            alt=""
            src="/public/images/misc/pokedle-logo.webp"
        /></a>
      </div>
      <div id="profile-name-container">
        <h1
          id="profile-name"
          data-profile-uid="<%= profileId %>"
          class="fadeIn profile-name-heading"
        >
          <%= username %>
        </h1>
        <button
          id="edit-profile-name-button"
          type="button"
          aria-label="Edit profile name"
          title="Edit profile name"
          hidden
        >
          &#9998;
        </button>
      </div>
      <form id="profile-name-form" hidden>
        <p id="profile-name-error" role="alert" aria-live="polite"></p>
        <input
          id="profile-name-input"
          type="text"
          maxlength="16"
          aria-label="Profile name"
        />
        <div id="profile-name-actions">
          <button id="save-profile-name-button" type="submit">
            <span
              id="save-profile-name-loader"
              class="profile-loader"
              role="status"
              aria-label="Saving"
              hidden
            ></span>
            <span>Save</span>
          </button>
          <button id="cancel-profile-name-button" type="button">Cancel</button>
        </div>
      </form>
      <div class="profile-mode-panels">
        <div class="profile-stat-card">
        <% if (companion) { %>
        <div class="profile-companion-container">
          <img
            class="profile-companion"
            src="<%= companion %>"
            alt="<%= username %>'s Pokémon companion"
          />
        </div>
        <% } %>
        <div class="mode-title">
          <span class="mode-line">Classic</span>
        </div>
        <div class="mode-data">
          <span class="mode-line">Wins: <%= classicWins %></span><br />
          <span class="mode-line">Average Tries: <%= classicAvgTries %></span><br /><br />
          <button id="onprofile-dex-button">View Pokédex</button>
        </div>
      </div>
      <div class="profile-stat-card">
        <div class="profile-sentry-stat mode-title">
          <span class="mode-line">Sentry Duty</span>
        </div>
        <div class="mode-data">
          <span class="mode-line">Best Score: <%= sentryBestScore %></span><br />
          <span class="mode-line">Most Rounds: <%= sentryBestSession %></span><br />
          <span class="mode-line">Recognized: <%= sentrySessionsCompleted %></span><br />
          <span class="mode-line">Accuracy: <%= sentryAccuracy %>%</span><br />
        </div>
      </div>
      </div>
    </div>
    <%- include("partials/page-modules", {
      modules: ["auth"],
    }) %>
    <script
      type="module"
      src="/public/js/profilePage.js?v=<%= encodeURIComponent(appVersion) %>"
    ></script>
    <script
      type="module"
      src="/public/js/profilePresets.js?v=<%= encodeURIComponent(appVersion) %>"
    ></script>
  </body>
</html>
