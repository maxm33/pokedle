<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="icon" href="/public/images/icons/favicon.ico" />
    <link rel="stylesheet" href="/public/stylesheets/style.css" />
    <link
      rel="manifest"
      type="application/manifest+json"
      href="/public/app.webmanifest"
    />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <title>Profile</title>
  </head>
  <body
    class="profile-page"
    style="--page-background-image: url(&quot;<%= bg %>&quot;); --profile-overlay-image: <%= overlay ? 'url(' + overlay + ')' : 'none' %>"
    data-rate-limit-toast="<%= typeof rateLimitToast === 'string' ? rateLimitToast : '' %>"
  >
    <div id="topnav" role="banner">
      <div id="credits">
        <p id="author">
          Created by <a href="https://github.com/maxm33">maxm33</a>
        </p>
        <img
          alt=""
          src="/public/images/icons/github-mark.webp"
          width="20px"
          height="20px"
        />
      </div>
      <div
        id="auth-loading"
        class="auth-loading"
        role="status"
        aria-live="polite"
      >
        <span class="profile-loader" aria-hidden="true"></span>
        <span>Checking authentication...</span>
      </div>
      <div id="buttons-container">
        <button id="login-button" class="topnav-buttons">
          <img
            id="login-img"
            alt=""
            src="/public/images/misc/login.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button
          id="shop-button"
          class="topnav-buttons"
          type="button"
          aria-label="Shop"
          title="Shop"
        >
          <img
            alt=""
            src="/public/images/misc/shop.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="ranking-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/ranking.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="pokedex-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/pokedex.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="profile-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/profile.webp"
            width="35px"
            height="35px"
          />
        </button>
      </div>
    </div>
    <button
      id="profile-background-toggle"
      type="button"
      aria-label="Show only the profile background"
      aria-pressed="false"
      title="Show only the profile background"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          class="profile-eye-open"
          d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Zm10 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z"
        />
        <path
          class="profile-eye-slash"
          d="m3 3 18 18M10.6 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.7 15.7 0 0 1-3.1 3.8M6.2 6.2C3.5 8.1 2 12 2 12s3.6 7 10 7a10.8 10.8 0 0 0 4.1-.8"
        />
      </svg>
    </button>
    <div id="container" role="main">
      <div id="logo" class="fadeIn">
        <a aria-label="Go to Home" href="/"
          ><img
            fetchpriority="high"
            alt=""
            src="/public/images/icons/pokedle-logo.webp"
        /></a>
      </div>
      <div id="profile-name-container">
        <h1
          id="profile-name"
          data-profile-uid="<%= profileId %>"
          style="margin-top: 1.5em; font-size: 1.2em"
          class="fadeIn"
        >
          <%= username %>
        </h1>
        <button
          id="edit-profile-name-button"
          type="button"
          aria-label="Edit profile name"
          title="Edit profile name"
          hidden
        >
          &#9998;
        </button>
      </div>
      <form id="profile-name-form" hidden>
        <p id="profile-name-error" role="alert" aria-live="polite"></p>
        <input
          id="profile-name-input"
          type="text"
          maxlength="16"
          aria-label="Profile name"
        />
        <div id="profile-name-actions">
          <button id="save-profile-name-button" type="submit">
            <span
              id="save-profile-name-loader"
              class="profile-loader"
              role="status"
              aria-label="Saving"
              hidden
            ></span>
            <span>Save</span>
          </button>
          <button id="cancel-profile-name-button" type="button">Cancel</button>
        </div>
      </form>
      <div class="profile-stat-card">
        <% if (companion) { %>
        <div class="profile-companion-container">
          <img
            class="profile-companion"
            src="<%= companion %>"
            alt="<%= username %>'s Pokémon companion"
          />
        </div>
        <% } %>
        <div id="mode-title">
          <span class="mode-line">Classic</span>
        </div>
        <div id="mode-data">
          <span class="mode-line">Wins: <%= classicWins %></span><br />
          <span class="mode-line">Average Tries: <%= classicAvgTries %></span><br /><br />
          <button id="onprofile-dex-button">View Pokédex</button>
        </div>
      </div>
      <div class="profile-stat-card">
        <div style="margin-top: 0.75em" id="mode-title">
          <span class="mode-line">Sentry Duty</span>
        </div>
        <div id="mode-data">
          <span class="mode-line">Best Score: <%= sentryBestScore %></span><br />
          <span class="mode-line">Best Session: <%= sentryBestSession %> rounds</span><br />
          <span class="mode-line">Recognized: <%= sentrySessionsCompleted %></span><br />
          <span class="mode-line">Accuracy: <%= sentryAccuracy %>%</span><br />
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script type="module" src="/public/js/auth.js"></script>
    <script>
      document
        .getElementById("onprofile-dex-button")
        .addEventListener("click", () => {
          let url = window.location.href;
          let url_cut = url.substring(0, url.length - 8); // removing "/profile"
          window.location.href = url_cut + "/pokedex";
        });

      const backgroundToggle = document.getElementById(
        "profile-background-toggle",
      );
      const eyeOpen = backgroundToggle.querySelector(".profile-eye-open");
      const eyeSlash = backgroundToggle.querySelector(".profile-eye-slash");
      backgroundToggle.addEventListener("click", () => {
        const isActive = document.body.classList.toggle(
          "profile-background-focus",
        );
        const label = isActive
          ? "Show the full profile"
          : "Show only the profile background";
        backgroundToggle.setAttribute("aria-pressed", String(isActive));
        backgroundToggle.setAttribute("aria-label", label);
        backgroundToggle.title = label;
      });
    </script>
  </body>
</html>
