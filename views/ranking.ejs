<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="icon" href="/public/images/icons/favicon.ico" />
    <script>
      try {
        const authState = sessionStorage.getItem("pokedleAuthState");
        if (authState === "signed-in" || authState === "signed-out") {
          document.documentElement.dataset.authState = authState;
        }
      } catch (err) {
        console.error("Failed to restore navigation state:", err);
      }
    </script>
    <link rel="stylesheet" href="/public/stylesheets/style.css" />
    <link
      rel="manifest"
      type="application/manifest+json"
      href="/public/app.webmanifest"
    />
    <meta name="viewport" content="initial-scale=1, width=device-width" />
    <title>Rankings</title>
  </head>
  <body class="ranking-page" style="--page-background-image: url(&quot;<%= bg %>&quot;)">
    <div id="topnav" role="banner">
      <div id="credits">
        <p id="author">
          Created by <a href="https://github.com/maxm33">maxm33</a>
        </p>
        <img
          alt=""
          src="/public/images/misc/github-mark.webp"
          width="20px"
          height="20px"
        />
      </div>
      <div id="auth-loading" class="auth-loading" role="status" aria-live="polite">
        <span class="profile-loader" aria-hidden="true"></span>
        <span>Checking authentication...</span>
      </div>
      <div id="buttons-container">
        <button id="login-button" class="topnav-buttons">
          <img
            id="login-img"
            alt=""
            src="/public/images/misc/login.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button
          id="shop-button"
          class="topnav-buttons"
          type="button"
          aria-label="Shop"
          title="Shop"
        >
          <img
            alt=""
            src="/public/images/misc/shop.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="ranking-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/ranking.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="pokedex-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/pokedex.webp"
            width="35px"
            height="35px"
          />
        </button>
        <button id="profile-button" class="topnav-buttons">
          <img
            alt=""
            src="/public/images/misc/profile.webp"
            width="35px"
            height="35px"
          />
        </button>
      </div>
    </div>
    <div id="container" role="main">
      <div id="logo" class="fadeIn">
        <a
          aria-label="<%= activeMode === 'sentry' ? 'Return to Sentry Duty' : 'Return to Classic' %>"
          href="<%= activeMode === 'sentry' ? '/sentry' : '/classic' %>"
          ><img fetchpriority="high" alt="" src="/public/images/misc/pokedle-logo.webp"
        /></a>
      </div>
      <div id="leaderboard-board" class="fadeIn">
        <div class="lb-header">
          <div class="lb-title-group">
            <h1>HALL OF FAME</h1>
            <p class="lb-subtitle">
              <span class="subtitle-gem-dot" aria-hidden="true"></span>
              POKÉDLE CHAMPIONS
              <span class="subtitle-gem-dot" aria-hidden="true"></span>
            </p>
          </div>
        </div>
        <div class="ranking-tabs" role="tablist" aria-label="Ranking mode">
          <button
            id="classic-ranking-tab"
            class="ranking-tab"
            type="button"
            role="tab"
            aria-controls="<%= activeMode %>-all-time-ranking-panel"
            aria-selected="<%= activeMode === 'classic' %>"
            tabindex="<%= activeMode === 'classic' ? 0 : -1 %>"
            data-ranking-mode="classic"
          >
            <span class="tab-pokeball" aria-hidden="true"></span>
            Classic
          </button>
          <button
            id="sentry-ranking-tab"
            class="ranking-tab"
            type="button"
            role="tab"
            aria-controls="<%= activeMode %>-all-time-ranking-panel"
            aria-selected="<%= activeMode === 'sentry' %>"
            tabindex="<%= activeMode === 'sentry' ? 0 : -1 %>"
            data-ranking-mode="sentry"
          >
            <span class="tab-pokeball" aria-hidden="true"></span>
            Sentry Duty
          </button>
        </div>
        <div class="ranking-tabs ranking-period-tabs" role="tablist" aria-label="Ranking period">
          <button
            id="all-time-ranking-tab"
            class="ranking-tab"
            type="button"
            role="tab"
            aria-controls="<%= activeMode %>-all-time-ranking-panel"
            aria-selected="true"
            tabindex="0"
            data-ranking-period="all-time"
          >
            All-Time
          </button>
          <button
            id="monthly-ranking-tab"
            class="ranking-tab"
            type="button"
            role="tab"
            aria-controls="<%= activeMode %>-monthly-ranking-panel"
            aria-selected="false"
            tabindex="-1"
            data-ranking-period="monthly"
          >
            Monthly
          </button>
        </div>
        <% const rankingSections = [
          { mode: "classic", period: "all-time", data: classicAllTimeRankingData },
          { mode: "sentry", period: "all-time", data: sentryAllTimeRankingData },
          { mode: "classic", period: "monthly", data: classicMonthlyRankingData },
          { mode: "sentry", period: "monthly", data: sentryMonthlyRankingData },
        ]; %>
        <% rankingSections.forEach((ranking) => { %>
        <section
          id="<%= ranking.mode %>-<%= ranking.period %>-ranking-panel"
          class="ranking-panel"
          role="tabpanel"
          aria-labelledby="<%= ranking.period === 'all-time' ? 'all-time' : 'monthly' %>-ranking-tab"
          <% if (ranking.mode !== activeMode || ranking.period !== "all-time") { %>hidden<% } %>
        >
          <div class="ranking-list">
            <% if (ranking.data.length === 0) { %>
            <p class="ranking-empty">
              No scores have been recorded for this ranking yet.
            </p>
            <% } %>
            <% for (let i = 0; i < ranking.data.length; i++) { %>
            <div class="ranking-rows rank-<%= i < 3 ? i + 1 : 'standard' %>">
              <div class="ranking-badge">
                <% if (i < 3) { %>
                <img
                  class="ranking-medal"
                  alt="<%= i + 1 %> place"
                  src="/public/images/misc/<%= i === 0 ? '1st' : i === 1 ? '2nd' : '3rd' %>.png"
                />
                <% } else { %>
                <span class="ranking-number">#<%= i + 1 %></span>
                <% } %>
              </div>
              <div class="ranking-trainer">
                <% if (i === 0) { %>
                <span class="ranking-tag-champion">♛ CHAMPION</span>
                <% } else if (i < 5) { %>
                <span class="ranking-tag-elite">ELITE FOUR</span>
                <% } %>
                <a
                  class="ranking-username"
                  aria-label="<%= ranking.data[i].id %>'s profile"
                  href="/user/<%= ranking.data[i].id %>/profile"
                  ><%= ranking.data[i].username %></a
                >
              </div>
              <div class="ranking-score">
                <span class="ranking-score-val"><%= ranking.data[i].score %></span>
                <span class="ranking-score-unit">pts</span>
              </div>
            </div>
            <% } %>
          </div>
        </section>
        <% }); %>
      </div>
    </div>
    <script>
      const rankingTabs = [...document.querySelectorAll("[data-ranking-mode]")];
      const periodTabs = [...document.querySelectorAll("[data-ranking-period]")];
      const rankingPanels = [...document.querySelectorAll(".ranking-panel")];
      const rankingLogo = document.querySelector("#logo a");

      function selectRankingTab(tab, focus = false) {
        const mode = tab.dataset.rankingMode;
        const period = periodTabs.find(
          (periodTab) =>
            periodTab.getAttribute("aria-selected") === "true",
        )?.dataset.rankingPeriod || "all-time";
        selectRankingView(mode, period, tab, null);
        if (focus) tab.focus();
      }

      function selectRankingView(mode, period, modeTab, periodTab) {
        const returnPath = mode === "sentry" ? "/sentry" : "/classic";
        rankingTabs.forEach((rankingTab) => {
          const isSelected = modeTab
            ? rankingTab === modeTab
            : rankingTab.dataset.rankingMode === mode;
          rankingTab.setAttribute("aria-selected", String(isSelected));
          rankingTab.tabIndex = isSelected ? 0 : -1;
          rankingTab.setAttribute(
            "aria-controls",
            `${rankingTab.dataset.rankingMode}-${period}-ranking-panel`,
          );
        });
        periodTabs.forEach((rankingTab) => {
          const isSelected = rankingTab === periodTab ||
            (!periodTab && rankingTab.dataset.rankingPeriod === period);
          rankingTab.setAttribute("aria-selected", String(isSelected));
          rankingTab.tabIndex = isSelected ? 0 : -1;
        });
        rankingPanels.forEach((panel) => {
          panel.hidden =
            panel.id !== `${mode}-${period}-ranking-panel`;
        });
        periodTabs.forEach((periodTab) => {
          periodTab.setAttribute(
            "aria-controls",
            `${mode}-${periodTab.dataset.rankingPeriod}-ranking-panel`,
          );
        });
        rankingLogo.href = returnPath;
        rankingLogo.setAttribute(
          "aria-label",
          mode === "sentry" ? "Return to Sentry Duty" : "Return to Classic",
        );

        const url = new URL(window.location.href);
        url.searchParams.set("mode", mode);
        window.history.replaceState(
          null,
          "",
          `${url.pathname}${url.search}${url.hash}`,
        );
      }

      rankingTabs.forEach((tab, index) => {
        tab.addEventListener("click", () => selectRankingTab(tab));
        tab.addEventListener("keydown", (event) => {
          let nextIndex;
          if (event.key === "ArrowRight" || event.key === "ArrowDown")
            nextIndex = (index + 1) % rankingTabs.length;
          else if (event.key === "ArrowLeft" || event.key === "ArrowUp")
            nextIndex = (index - 1 + rankingTabs.length) % rankingTabs.length;
          else if (event.key === "Home") nextIndex = 0;
          else if (event.key === "End") nextIndex = rankingTabs.length - 1;
          else return;

          event.preventDefault();
          selectRankingTab(rankingTabs[nextIndex], true);
        });
      });
      periodTabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          const mode = rankingTabs.find(
            (rankingTab) => rankingTab.getAttribute("aria-selected") === "true",
          ).dataset.rankingMode;
          selectRankingView(mode, tab.dataset.rankingPeriod, null, tab);
        });
        tab.addEventListener("keydown", (event) => {
          let nextIndex;
          if (event.key === "ArrowRight" || event.key === "ArrowDown")
            nextIndex = (index + 1) % periodTabs.length;
          else if (event.key === "ArrowLeft" || event.key === "ArrowUp")
            nextIndex = (index - 1 + periodTabs.length) % periodTabs.length;
          else if (event.key === "Home") nextIndex = 0;
          else if (event.key === "End") nextIndex = periodTabs.length - 1;
          else return;

          event.preventDefault();
          periodTabs[nextIndex].click();
          periodTabs[nextIndex].focus();
        });
      });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script type="module" src="/public/js/auth.js"></script>
  </body>
</html>
