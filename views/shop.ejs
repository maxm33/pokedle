<!DOCTYPE html>
<html lang="en">
  <%- include("partials/head", {
    title: "PokéShop",
    modules: ["base", "shop", "profile-account", "responsive", "music-player"]
  }) %>
  <body
    style="--page-background-image: url(&quot;<%= bg %>&quot;)"
    data-shop-fields="<%= JSON.stringify(shopFields) %>"
    data-rate-limit-toast="<%= typeof rateLimitToast === 'string' ? rateLimitToast : '' %>"
  >
        <%- include("partials/topnav") %>
    <header class="shop-header">
      <div class="shop-brand">
        <a
          class="shop-back"
          href="/classic"
          aria-label="Return to Classic"
          title="Return to Classic"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M15.5 4.5 8 12l7.5 7.5"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
            />
          </svg>
        </a>
        <span class="shop-brand-ball" aria-hidden="true"></span>
        <span>PokéShop</span>
      </div>
      <div class="shop-inventory-container">
        <button
          id="inventory-button"
          class="shop-inventory-btn"
          type="button"
          aria-label="Inventory"
          title="Inventory"
        >
          <img
            src="/public/images/misc/backpack.webp"
            alt=""
            width="28"
            height="28"
          />
          <span class="shop-inventory-text">Inventory</span>
        </button>
        <span class="shop-inventory-label">(<span id="shop-inventory-count">0</span>)</span>
      </div>
      <div class="shop-wallet is-loading">
        <span
          id="shop-wallet-loader"
          class="profile-loader"
          role="status"
          aria-label="Loading balance"
        ></span>
        <span class="shop-currency" aria-hidden="true">₽</span>
        <span id="shop-wallet" aria-live="polite" hidden></span>
      </div>
    </header>
    <main class="shop-page">
      <p class="shop-rewards">
        Customize your profile with backgrounds, overlays and Pokémon companions!
      </p>
      <nav class="shop-tabs" aria-label="Shop sections">
        <button
          class="shop-tab is-active"
          data-shop-section="background"
          type="button"
          aria-pressed="true"
        >
          Background
        </button>
        <button
          class="shop-tab"
          data-shop-section="overlay"
          type="button"
          aria-pressed="false"
        >
          Overlay
        </button>
        <button
          class="shop-tab"
          data-shop-section="companion"
          type="button"
          aria-pressed="false"
        >
          Companion
        </button>
        <button
          class="shop-tab"
          data-shop-section="boost"
          type="button"
          aria-pressed="false"
        >
          Boost
        </button>
      </nav>
      <div class="shop-search-container">
        <button
          id="shop-favorites-filter-button"
          class="shop-filter-button shop-favorites-filter-button"
          type="button"
          aria-label="Show favorite items only"
          aria-pressed="false"
          title="Show favorite items only"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </button>
        <input type="text" id="shop-search" class="shop-search-input" placeholder="Search items..." aria-label="Search items" />
        <button
          id="shop-filter-button"
          class="shop-filter-button"
          type="button"
          aria-label="Open shop filters"
          aria-haspopup="dialog"
          aria-expanded="false"
        >
          <img
            src="/public/images/misc/filter.webp"
            alt=""
            width="18"
            height="18"
          />
        </button>
      </div>
      <dialog id="shop-filter-dialog" class="shop-filter-dialog" aria-labelledby="shop-filter-title">
        <form id="shop-filter-form" method="dialog">
          <div class="shop-filter-header">
            <h2 id="shop-filter-title">Sort Items</h2>
            <button id="shop-filter-close" class="shop-filter-close" type="button" aria-label="Close filters" autofocus>&times;</button>
          </div>
          <label class="shop-filter-field" for="shop-sort">
            <span id="shop-sort-label">Sort items</span>
            <select id="shop-sort" name="sort">
              <option value="default">Default order</option>
              <option value="price-asc">Price: lowest to highest</option>
              <option value="price-desc">Price: highest to lowest</option>
              <option value="date-asc">Date: oldest first</option>
              <option value="date-desc">Date: newest first</option>
            </select>
          </label>
          <label id="shop-discount-filter" class="shop-filter-discount">
            <input id="shop-discount-only" name="discountOnly" type="checkbox" />
            <span>Show only discounts</span>
          </label>
          <div class="shop-filter-actions">
            <button id="shop-filter-reset" class="shop-filter-reset" type="button">Reset</button>
            <button class="shop-filter-apply" type="submit">Apply</button>
          </div>
        </form>
      </dialog>
      <div id="shop-items" class="shop-grid">
        <% shopItems.forEach((item) => { %>
        <article
          class="shop-item"
          data-item-id="<%= item.id %>"
          data-item-type="<%= item.type %>"
          data-purchasable="<%= item.purchasable !== false %>"
          data-discounted="<%= item.discountPercent ? 'true' : 'false' %>"
          data-published-at="<%= item.publishedAt || '' %>"
          data-published-order="<%= item.publishedOrder ?? '' %>"
          hidden
        >
          <button
            class="shop-item-favorite"
            type="button"
            data-item-id="<%= item.id %>"
            data-item-type="<%= item.type %>"
            aria-label="Add <%= item.displayName %> to favorites"
            aria-pressed="false"
            title="Add to favorites"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>
          </button>
          <button
            class="shop-item-sell"
            type="button"
            data-action="sell"
            data-item-id="<%= item.id %>"
            data-item-type="<%= item.type %>"
            aria-label="Sell <%= item.displayName %>"
            title="Sell item"
            hidden
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M4 7h16M9 7V4h6v3m3 0-1 13H7L6 7m4 3v7m4-7v7"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
              />
            </svg>
          </button>
          <picture class="shop-image-frame">
            <% if (item.type === "background") { %>
            <source
              media="(max-width: 670px)"
              srcset="<%= item.mobileUrl %>"
            />
            <% } %>
            <img
              class="shop-preview"
              src="<%= item.type === "background" ? item.desktopUrl : item.imageUrl %>"
              alt="<%= item.name %>"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <div class="shop-item-content">
            <h2><%= item.displayName %></h2>
            <div class="shop-price shop-price-column">
              <% if (item.discountPercent) { %>
                <div class="shop-original-price-row">
                  <span class="shop-original-price">
                    ₽ <%= item.originalPrice.toLocaleString("en-US") %>
                  </span>
                  <span class="shop-discount-badge">
                    -<%= item.discountPercent %>%
                  </span>
                </div>
              <% } %>
              <div class="shop-current-price-row">
                <span class="shop-currency" aria-hidden="true">₽</span>
                <span><%= item.price.toLocaleString("en-US") %></span>
              </div>
            </div>
            <p class="shop-boost-quantity" hidden></p>
            <button
              class="shop-item-action"
              type="button"
              data-action="purchase"
              data-item-id="<%= item.id %>"
              data-item-type="<%= item.type %>"
              data-price="<%= item.price %>"
              disabled
            >
              Buy
            </button>
          </div>
        </article>
        <% }); %>
      </div>
      <p id="shop-empty-state" class="shop-empty-state" hidden></p>
    </main>
    <button
      id="shop-scroll-top"
      class="shop-scroll-top"
      type="button"
      aria-label="Back to top"
      title="Back to top"
      aria-hidden="true"
      tabindex="-1"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M5 12 12 5l7 7M12 5v14"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2.5"
        />
      </svg>
    </button>
    <%- include("partials/page-modules", {
      modules: ["auth", "shop", "musicPlayer"],
    }) %>
  </body>
</html>
