{
  "name": "pokedle",
  "version": "1.9.0",
  "description": "Pokédle is a game heavily inspired by Wordle and LoLdle, in which you have to guess the daily secret pokémon.",
  "homepage": "https://github.com/maxm33/pokedle#readme",
  "repository": "github:maxm33/pokedle",
  "author": "Massimo Monai (https://github.com/maxm33)",
  "license": "MIT",
  "scripts": {
    "prestart": "npm run assets:playlist && npm run assets:companions && npm run assets:manifest",
    "start": "node ./bin/www",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check_syntax.js",
    "lint": "eslint app.js lib routes scripts test eslint.config.js",
    "assets:manifest": "node scripts/generate_asset_manifest.js",
    "assets:playlist": "node scripts/generate_playlist.js",
    "assets:companions": "node scripts/generate_companion_catalog.js",
    "assets:check": "node scripts/check_assets.js",
    "assets:audio:dry-run": "node scripts/optimize_audio.js",
    "assets:audio": "node scripts/optimize_audio.js --apply"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "http-errors": "^2.0.0",
    "morgan": "^1.10.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0"
  },
  "overrides": {
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "supertest": "^7.1.4"
  }
}
